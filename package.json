{
  "name": "batch-compress-img",
  "version": "1.0.0",
  "description": "批量压缩图片和视频的桌面工具",
  "main": "main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:python": "cd backend && python -m PyInstaller compress.spec --clean",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build:frontend && npm run build:python",
    "package": "node scripts/package-simple.js",
    "package:old": "node scripts/build.js",
    "electron:build": "npm run build && electron-builder",
    "electron:dev": "electron-vite dev",
    "start": "electron ."
  },
  "keywords": [
    "electron",
    "react",
    "image-compression",
    "video-compression"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-vite": "^1.0.27",
    "vite": "^4.5.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.batchcompress.app",
    "productName": "批量压缩工具",
    "copyright": "Copyright © 2026",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "frontend/public/icon.ico",
      "uninstallerIcon": "frontend/public/icon.ico",
      "installerHeaderIcon": "frontend/public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "批量压缩工具"
    },
    "directories": {
      "output": "dist",
      "buildResources": "frontend/public"
    },
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist",
        "filter": [
          "compress.exe"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
